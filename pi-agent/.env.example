# -----------------------------------------------------------------------------
# Pi Agent configuration — per branch. Copy this file to `.env` on the Pi
# and fill in the real values (never commit `.env`).
# -----------------------------------------------------------------------------

# Identity of this branch in the gan-halomot server (MongoDB ObjectId).
BRANCH_ID=

# Shared secret for this branch (printed by `scripts/seed-attendance.js`).
AGENT_SECRET=

# TIMEDOX clock connection
CLOCK_IP=10.0.0.3
CLOCK_PORT=4370
CLOCK_TIMEOUT_MS=10000
CLOCK_INPORT=5200

# Server URL (production) — include protocol, no trailing slash
SERVER_URL=https://gan-halomot.onrender.com

# Polling intervals (milliseconds)
POLL_PUNCHES_MS=15000
POLL_COMMANDS_MS=30000
POLL_HEARTBEAT_MS=60000

# Networking
HTTP_TIMEOUT_MS=15000
HTTP_RETRY_MAX=5
HTTP_RETRY_BASE_MS=2000

# Where the agent keeps its local state (last_user_sn, last successful poll, etc.)
STATE_FILE=./state.json

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Use the timestamp the DEVICE reports for each record. Leave this TRUE.
#
# It used to default to false, because node-zklib returns 1999-12-31 for
# historical records on TANDEM4 PRO firmware. But falling back to "now" is only
# harmless while polling is healthy — after ANY outage the whole backlog uploads
# stamped with the moment of reconnection, not when people actually punched.
# That destroyed 21 punches at Herzliya (2026-05-06) and 64 punches over 2.5 days
# at Moshe Dayan (2026-07-22), whose Pi still had this set to false.
#
# agent.js now detects the garbage-decoder case on its own (any time before 2010
# falls back to receive-time for that record only), so trusting the device is
# both safe and correct. Set to false ONLY for a specific Pi whose firmware is
# proven to lie, and never for one that could ever go offline.
TRUST_DEVICE_TIMESTAMPS=true
