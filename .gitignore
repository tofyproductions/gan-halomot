node_modules/
.env
.env.local
dist/
build/
*.log
.DS_Store
coverage/
.idea/
.vscode/
*.tgz
data/

# Cibus discovery output — contains employee names and a logged-in session.
# Never commit it.
server/cibus-capture/
cibus-capture/

# Backups of .env are still .env — the plain ".env" rule above does not catch them.
.env.backup*
.env.*.backup

# The local demo database built by scripts/ganflow-demo-local.js. It is a whole
# MongoDB on disk — scrambled, but there is no reason for it to be in the repo,
# and a failed scramble would put real children here.
server/.demo-data/

# Capacitor — keep project files, ignore build outputs + IDE caches
client/android/.gradle/
client/android/build/
client/android/app/build/
client/android/app/release/
client/android/local.properties
client/android/key.properties
client/android/.idea/
client/android/captures/
client/ios/App/Pods/
client/ios/App/build/
client/ios/App/DerivedData/
client/ios/.DS_Store
*.xcuserdata/
*.xcuserstate

# Throwaway client build pointed at the local demo server (scripts/demo-server.js) — regenerate, don't commit.
client/dist-demo/
