#!/bin/bash
WINDOW_MIN=5
while read -r _l local_sha remote_ref _r; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  git fetch origin main --quiet 2>/dev/null

  BEHIND=$(git rev-list --count "$local_sha..origin/main" 2>/dev/null || echo 0)
  if [ "$BEHIND" -gt 0 ]; then
    echo ""
    echo "  STOP: origin/main has $BEHIND commit(s) you do not have."
    echo "  Someone pushed in parallel. This push ignores their work."
    echo ""
    echo "    git pull --rebase origin main    then push again"
    echo ""
    exit 1
  fi

  LAST=$(git log -1 --format=%ct origin/main 2>/dev/null || echo 0)
  AGE=$(( ( $(date +%s) - LAST ) / 60 ))
  if [ "$LAST" -gt 0 ] && [ "$AGE" -lt "$WINDOW_MIN" ]; then
    echo ""
    echo "  STOP: last commit on origin/main is ${AGE}m old."
    echo "  The previous deploy is probably still building."
    echo ""
    echo "    wait a few minutes, or:  git push --no-verify"
    echo ""
    exit 1
  fi

  echo ""
  echo "  OK - main is in sync, previous deploy finished. Going live:"
  git log --oneline "origin/main..$local_sha" | sed 's/^/    /'
  echo ""
done
exit 0
